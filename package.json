{
  "name": "cachos",
  "version": "0.1.0",
  "description": "Cacho/Dudo chileno para jugar remoto entre amigos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build:engine": "node scripts/bundle-engine.mjs",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs --external:bufferutil --external:utf-8-validate",
    "start:server": "node dist-server/server.cjs",
    "preview:html": "esbuild scripts/preview.tsx --bundle --platform=node --format=esm --outfile=preview/_run.mjs --log-level=warning && node preview/_run.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.2.8",
    "@supabase/supabase-js": "^2.108.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.18.0"
  }
}
